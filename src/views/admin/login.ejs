<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng nhập - Quản trị</title>
  <style>
    /* Tổng thể căn giữa */
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #fff;
    }

    .login-box {
      width: 100%;
      max-width: 400px;
      text-align: center;
      padding: 2rem;
    }

    .login-logo {
      width: 150px;
      height: auto;
      display: block;
      margin: 0 auto 1.5rem;
    }

    .login-title {
      font-weight: 700;
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .form-group {
      text-align: left;
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-weight: 500;
      margin-bottom: 0.25rem;
    }

    .form-control {
      width: 100%;
      padding: 0.75rem;
      border: none;
      border-bottom: 1px solid #000;
      outline: none;
      font-size: 1rem;
    }

    .form-control::placeholder {
      color: #aaa;
    }

    .btn-login {
      width: 100%;
      background: #000;
      color: #fff;
      font-weight: 600;
      padding: 0.75rem;
      border: none;
      border-radius: 0;
      margin-top: 1rem;
      transition: background 0.3s ease;
      cursor: pointer;
    }

    .btn-login:hover {
      background: #333;
    }

    .error-message {
      color: #ef4444;
      background: rgba(239, 68, 68, 0.1);
      padding: 1rem;
      border-radius: 6px;
      margin-top: 1rem;
    }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-box">
      <img
        src="https://res.cloudinary.com/dnyb9bbkr/image/upload/v1761404700/484065696_2519918064878637_3662425263367956365_n_hvlqms.jpg"
        alt="Logo"
        class="login-logo"
      />

      <h2 class="login-title">Đăng nhập</h2>

      <form id="loginForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="admin@gmail.com"
            value="admin@gmail.com"
            required
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="1"
            value="1"
            required
          />
        </div>

        <button type="submit" class="btn-login">Đăng nhập</button>
        <div class="error-message" id="error-message"></div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const errorDiv = document.getElementById('error-message');

      try {
        const res = await fetch('/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();
        console.log('Server response:', data);

        if (data.success) {
          // KHÔNG DÙNG localStorage → DÙNG SESSION
          window.location.href = data.redirect || '/admin/dashboard/product';
        } else {
          errorDiv.textContent = data.error || 'Đăng nhập thất bại!';
          errorDiv.style.display = 'block';
        }
      } catch (err) {
        console.error('Client error:', err);
        errorDiv.textContent = 'Lỗi hệ thống, vui lòng thử lại!';
        errorDiv.style.display = 'block';
      }
    });
  </script>
</body>
</html>
