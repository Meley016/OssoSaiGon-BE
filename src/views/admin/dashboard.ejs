<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin</title>
  <link id="favicon" rel="icon" type="image/png" href="/images/default-logo.png" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/antd/4.24.14/antd.min.css"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/ant-design-icons/4.7.0/anticons.min.css"
  />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/17.0.2/umd/react.production.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/17.0.2/umd/react-dom.production.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/antd/4.24.14/antd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ant-design-icons/4.7.0/index.umd.min.js"></script>

</head>
<body>
  <!-- Header -->
  <div class="header">
    <div class="logo">
      <a href="/admin/dashboard/product">
        <img id="adminLogo" src="/images/default-logo.png" alt="Logo" />
      </a>
      <h1>Admin Dashboard</h1>
      
      <div id="adminNotifyBell">
      </div>

    </div>
    
    <form action="/admin/logout" method="POST">
      <button type="submit" class="logout-btn">Đăng xuất</button>
    </form>
  </div>

  <!-- Main content -->
  <div class="content">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      
      <!-- Helper: Kiểm tra role được phép -->
      <% 
        const role = admin?.role || 'user';
        const can = (roles) => roles.includes(role);
      %>

      <!-- MENU THEO QUYỀN -->
       <% if (can(['admin'])) { %>
          <a href="/admin/dashboard/report"
            class="<%= activeMenu === 'report' ? 'active' : '' %>">
            Báo cáo & Thống kê
          </a>
        <% } %>

      <% if (can(['admin', 'productAdder'])) { %>
        <a href="/admin/dashboard/product" class="<%= activeMenu === 'product' ? 'active' : '' %>">Sản phẩm</a>
      <% } %>

      <% if (can(['admin'])) { %>
        <a href="/admin/dashboard/order" class="<%= activeMenu === 'order' ? 'active' : '' %>">Đơn hàng</a>
      <% } %>

      <% if (can(['admin'])) { %>
        <a href="/admin/dashboard/user" class="<%= activeMenu === 'user' ? 'active' : '' %>">Người dùng</a>
      <% } %>

      <% if (can(['admin', 'productAdder'])) { %>
        <a href="/admin/dashboard/category" class="<%= activeMenu === 'category' ? 'active' : '' %>">Danh mục</a>
      <% } %>

      <% if (can(['admin', 'productAdder'])) { %>
        <a href="/admin/dashboard/promotion" class="<%= activeMenu === 'promotion' ? 'active' : '' %>">Khuyến mãi</a>
      <% } %>

      <% if (can(['admin'])) { %>
        <a href="/admin/dashboard/shipping" class="<%= activeMenu === 'shipping' ? 'active' : '' %>">Vận chuyển</a>
      <% } %>

      <% if (can(['admin', 'productAdder'])) { %>
        <a href="/admin/dashboard/size" class="<%= activeMenu === 'size' ? 'active' : '' %>">Size</a>
      <% } %>

      <% if (can(['admin', 'productAdder'])) { %>
        <a href="/admin/dashboard/color" class="<%= activeMenu === 'color' ? 'active' : '' %>">Màu</a>
      <% } %>

      <% if (can(['admin', 'writer'])) { %>
        <a href="/admin/dashboard/blog" class="<%= activeMenu === 'blog' ? 'active' : '' %>">Bài viết</a>
      <% } %>

      <% if (can(['admin', 'writer'])) { %>
        <a href="/admin/dashboard/banner" class="<%= activeMenu === 'banner' ? 'active' : '' %>">Banner</a>
      <% } %>

      <% if (can(['admin'])) { %>
        <a href="/admin/dashboard/footer" class="<%= activeMenu === 'footer' ? 'active' : '' %>">Footer</a>
      <% } %>
      <button id="toggleSidebar" class="toggle-sidebar-btn">&lt;</button>
    </div>

    <!-- Main area -->
    <div class="main" id="mainContent">
      <%- include(`../partials/${activeMenu}`, { 
        activeMenu, 
        admin, 
        orders, categories, sizes, colors, products, users, promotions, shippings, blogs, banners, footer
      }) %>
    </div>
  </div>

  <!-- Script: Toggle sidebar + Load logo -->
  <script>
    async function loadNotifyCount() {
      try {
        const res = await fetch("/api/notifications/unseen-count");
        const { total } = await res.json();
        const notifyBadge = document.getElementById("notifyBadge");

        if (total > 0) {
          notifyBadge.textContent = total;
          notifyBadge.style.display = "flex";
        } else {
          notifyBadge.style.display = "none";
        }
      } catch {}
    }

    loadNotifyCount();
    setInterval(loadNotifyCount, 30000);

    // Toggle Sidebar
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleSidebar');

    const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
    if (isSidebarHidden) {
      sidebar.classList.add('hidden');
      mainContent.classList.add('expanded');
      toggleBtn.innerHTML = '&gt;';
    }

    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('hidden');
      mainContent.classList.toggle('expanded');
      const isHidden = sidebar.classList.contains('hidden');
      toggleBtn.innerHTML = isHidden ? '&gt;' : '&lt;';
      localStorage.setItem('sidebarHidden', isHidden);
    });

    // Load Logo
    document.addEventListener("DOMContentLoaded", async () => {
      try {
        const res = await fetch("/api/banners/active?type=logo");
        if (!res.ok) throw new Error("Không tải được logo!");
        const data = await res.json();
        const logo = data[0];
        const imgEl = document.getElementById("adminLogo");
        const favicon = document.getElementById("favicon"); 
        const logoUrl = logo?.image || "/images/default-logo.png";
        imgEl.src = logoUrl;
        favicon.href = logoUrl;
      } catch (err) {
        console.warn("Lỗi tải logo:", err.message);
      }
    });
    const { Badge } = antd;
    const { BellOutlined } = icons;

    async function renderNotifyBell() {
      let count = 0;

      try {
        const res = await fetch("/api/notifications/unseen-count");
        const data = await res.json();
        count = data.total || 0;
      } catch (e) {}

      ReactDOM.render(
        React.createElement(
          "a",
          {
            href: "/admin/dashboard/notification",
            style: {
              fontSize: "20px",
              color: "#333",
              padding: "6px",
              borderRadius: "8px",
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
            },
          },
          React.createElement(
            Badge,
            {
              count,
              overflowCount: 99,
              size: "small",
            },
            React.createElement(BellOutlined, {
              style: { fontSize: "20px" },
            })
          )
        ),
        document.getElementById("adminNotifyBell")
      );
    }

    renderNotifyBell();
    setInterval(renderNotifyBell, 30000);
  </script>
</body>
</html>