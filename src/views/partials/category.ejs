<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/antd@5.12.0/dist/reset.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/antd@5.12.0/dist/antd.min.css" />
<link rel="stylesheet" href="/css/globe.css">

<div class="category-container">
  <form id="category-form" class="form-section" enctype="multipart/form-data">
      <h2 class="section-title">Quản lý Danh mục</h2>

    <div class="form-grid">
      <input type="text" name="name" placeholder="Tên danh mục" class="input-field" required />
      <textarea name="description" placeholder="Mô tả (tùy chọn)" class="input-field" rows="2"></textarea>
      <input type="file" name="categoryImage" accept="image/*" class="input-field" />
    </div>
    <div class="button-row">
      <button type="submit" class="btn-custom">Tạo Danh mục</button>
      <button type="reset" class="btn-reset">Đặt lại</button>
    </div>
  </form>

  <div class="item-grid" id="categoryGrid"></div>
</div>

<!-- EDIT MODAL -->
<div id="editModal" class="modal" enctype="multipart/form-data">
  <div class="modal-content">
    <span class="modal-close" onclick="closeEditModal()">&times;</span>
    <h3>Sửa Danh mục</h3>
    <form id="edit-form">
      <input type="hidden" id="edit-id" name="id" />
      <div class="form-grid">
        <input type="text" id="edit-name" name="name" placeholder="Tên danh mục" class="ant-input" required />
        <textarea id="edit-description" name="description" placeholder="Mô tả" class="ant-input" rows="2"></textarea>
        <input type="file" name="categoryImage" accept="image/*" class="input-field" />
      </div>
      <div id="edit-preview" style="margin-top:8px;text-align:center;display:none;">
        <img id="edit-img" src="" alt="preview" style="width:40%;height:40%;object-fit:cover;border-radius:8px;border:1px solid #eee;" />
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-delete" onclick="closeEditModal()">Hủy</button>
        <button type="submit" class="btn-edit">Cập nhật</button>
      </div>
    </form>
  </div>
</div>

<!-- 🟥 MODAL XÁC NHẬN / CẢNH BÁO -->
<div id="deleteModal" class="modal">
  <div class="modal-content" style="max-width:400px;text-align:center;">
    <h3 id="delete-title">Xác nhận xóa</h3>
    <p id="delete-message"></p>
    <div class="modal-actions" style="margin-top:16px;">
      <button id="confirmDeleteBtn" class="btn-delete">Xóa</button>
      <button class="btn-edit" onclick="closeDeleteModal()">Hủy</button>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", async () => {
  const grid = document.getElementById("categoryGrid");
  const deleteModal = document.getElementById("deleteModal");
  const deleteMsg = document.getElementById("delete-message");
  const deleteTitle = document.getElementById("delete-title");
  const confirmBtn = document.getElementById("confirmDeleteBtn");
  let deleteTargetId = null;

  async function loadCategories() {
    try {
      const res = await fetch("/api/categories");
      if (!res.ok) throw new Error("Không thể tải danh mục");
      const categories = await res.json();

      grid.innerHTML = categories.length
        ? categories.map(cat => `
          <div class="size-card">
            ${cat.image ? `<img src="${cat.image}" alt="${cat.name}" style="width:100%;height:150px;object-fit:cover;border-radius:8px;margin-bottom:6px;">` : ""}
            <h4>${cat.name}</h4>
            <p><strong>Mô tả:</strong> ${cat.description || 'Không có'}</p>
            <p><small>${new Date(cat.createdAt).toLocaleDateString()}</small></p>
            <div style="margin-top: 12px;">
              <button class="btn btn-edit" onclick="editCategory('${cat._id}', '${cat.name}', \`${cat.description || ''}\`, '${cat.image || ''}')">Sửa</button>
              <button class="btn btn-delete" onclick="checkBeforeDelete('${cat._id}')">Xóa</button>
            </div>
          </div>
        `).join("")
        : '<p style="text-align:center;padding:20px;">Chưa có danh mục nào.</p>';
    } catch (error) {
      grid.innerHTML = `<p class="error-text">Lỗi: ${error.message}</p>`;
    }
  }

  // 🟢 CREATE
  document.getElementById("category-form").addEventListener("submit", async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const name = formData.get('name').trim();
    if (!name) return alert("Tên danh mục không được để trống!");
    try {
      const res = await fetch("/api/categories", { method: "POST", body: formData });
      if (!res.ok) throw new Error("Thêm thất bại");
      alert("Thêm danh mục thành công!");
      e.target.reset();
      loadCategories();
    } catch (err) {
      alert("Lỗi: " + err.message);
    }
  });

  // 🟡 EDIT
  window.editCategory = (id, name, description, image) => {
    document.getElementById('edit-id').value = id;
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-description').value = description;
    const preview = document.getElementById('edit-preview');
    const img = document.getElementById('edit-img');
    if (image) { img.src = image; preview.style.display = "block"; }
    else { preview.style.display = "none"; img.src = ""; }
    document.getElementById('editModal').style.display = 'block';
  };

  document.getElementById("edit-form").addEventListener("submit", async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const id = formData.get("id");
    try {
      const res = await fetch(`/api/categories/${id}`, { method: "PUT", body: formData });
      if (!res.ok) throw new Error("Cập nhật thất bại");
      alert("Cập nhật thành công!");
      closeEditModal();
      loadCategories();
    } catch (err) {
      alert("Lỗi: " + err.message);
    }
  });

  // 🔴 DELETE — kiểm tra phụ thuộc sản phẩm trước
  window.checkBeforeDelete = async (id) => {
    try {
      const res = await fetch(`/api/categories/check/${id}`);
      const data = await res.json();

      deleteTargetId = id;
      deleteModal.style.display = "block";

      if (data.hasProducts) {
        deleteTitle.textContent = "Không thể xóa danh mục";
        deleteMsg.innerHTML = "Danh mục này đang được liên kết với sản phẩm, không thể xóa.";
        confirmBtn.style.display = "none";
      } else {
        deleteTitle.textContent = "Xác nhận xóa danh mục";
        deleteMsg.innerHTML = "Bạn có chắc muốn xóa danh mục này không?";
        confirmBtn.style.display = "inline-block";
      }
    } catch (err) {
      alert("Lỗi kiểm tra: " + err.message);
    }
  };

  confirmBtn.addEventListener("click", async () => {
    if (!deleteTargetId) return;
    try {
      const res = await fetch(`/api/categories/${deleteTargetId}`, { method: "DELETE" });
      if (!res.ok) throw new Error("Xóa thất bại");
      alert("Xóa thành công!");
      closeDeleteModal();
      loadCategories();
    } catch (err) {
      alert("Lỗi: " + err.message);
    }
  });

  // ⚙️ Modal helpers
  window.closeEditModal = () => document.getElementById('editModal').style.display = 'none';
  window.closeDeleteModal = () => deleteModal.style.display = 'none';
  window.onclick = (e) => {
    if (e.target === document.getElementById('editModal')) closeEditModal();
    if (e.target === deleteModal) closeDeleteModal();
  };

  loadCategories();
});
</script>
