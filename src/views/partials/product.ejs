  // === CẬP NHẬT ===
 document.getElementById("edit-form").onsubmit = async e => {
  e.preventDefault();

  const id = document.getElementById("edit-id").value;
  const formData = new FormData();

  // ===== INFO CHUNG =====
  ["SKU", "name", "brand", "category", "description"].forEach(f => {
    const el = document.getElementById(`edit-${f}`);
    if (el?.value) formData.append(f, el.value.trim());
  });

  // ===== VARIANTS =====
  const rows = document.querySelectorAll("#editVariantBody tr");
  const variants = [];
  const uploadedColors = new Set();

  rows.forEach(row => {
    const variantId =
      row.querySelector("input[name='variantId[]']")?.value || null;

    const colorId =
      row.querySelector("input[name='colorId[]']")?.value ||
      row.querySelector("select[name='variantColor[]']")?.value;

    const sizeId =
      row.querySelector("input[name='sizeId[]']")?.value ||
      row.querySelector("select[name='variantSize[]']")?.value;

    const stock = Number(
      row.querySelector("input[name='stock[]'], input[name='variantStock[]']")
        ?.value || 0
    );

    const price = Number(
      row.querySelector("input[name='price[]'], input[name='variantPrice[]']")
        ?.value || 0
    );

    if (!colorId || !sizeId || price <= 0) return;

    variants.push({
      _id: variantId,
      color: colorId,
      size: sizeId,
      stockQuantity: stock,
      price
    });

    // 🔥 upload ảnh MỖI COLOR 1 LẦN
    if (!uploadedColors.has(colorId)) {
      const fileInput = row.querySelector(
        `.variant-file-input[data-color="${colorId}"]`
      );
      if (fileInput?.files?.length) {
        [...fileInput.files].forEach(f =>
          formData.append(`variantImageFile[${colorId}]`, f)
        );
      }
      uploadedColors.add(colorId);
    }
  });

  if (!variants.length) {
    return showToast("Cần ít nhất 1 biến thể hợp lệ!", "error");
  }

  formData.append("variants", JSON.stringify(variants));

  // ===== GIỮ ẢNH CŨ (THEO COLOR) =====
  document.querySelectorAll("input[name='keepImages[]']").forEach(i => {
    formData.append("keepImages[]", i.value);
  });

  // ===== XÓA ẢNH CŨ (CHỈ KHI BẤM X) =====
  document.querySelectorAll("input[name='removeImages[]']").forEach(i => {
    formData.append("removeImages[]", i.value);
  });

  showLoading("Đang cập nhật...");
  try {
    const res = await fetch(`/api/products/${id}`, {
      method: "PUT",
      body: formData
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Lỗi cập nhật");

    showToast("Cập nhật thành công!");
    closeEditModal();
    loadProducts();
  } catch (err) {
    showToast(err.message, "error");
  } finally {
    hideLoading();
  }
};

