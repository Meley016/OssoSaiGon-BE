<script>
let colorsRes = [], sizesRes = [], categoriesRes = [];
let currentFilters = {};
let currentPage = 1;
const limit = 21;
let selectedProductIds = [];

function showLoading(text = "Đang xử lý...") {
  const el = document.getElementById("globalLoading");
  document.getElementById("loadingText").textContent = text;
  el.style.display = "flex";
}

function hideLoading() {
  document.getElementById("globalLoading").style.display = "none";
}

// === THÊM BIẾN THỂ ===
function addVariantRow(body, variant = {}, isEdit = false) {
  const rowIndex = body.children.length;
  const maxImages = 6;
  const currentImages = variant.images || [];
  const isEditingExisting = isEdit && variant._id; // true nếu đang sửa variant cũ

  const row = document.createElement("tr");

  row.innerHTML = `
    ${isEditingExisting ? `<input type="hidden" name="existingVariantId[]" value="${variant._id}">` : ""}
    <td data-label="Màu">
      ${isEditingExisting
        ? `
           <span>${variant.color?.name || 'N/A'}</span>
           <input type="hidden" name="variantColor[]" value="${variant.color?._id || variant.color || ''}">
           <input type="hidden" name="existingVariantColor[]" value="${variant.color?._id || variant.color || ''}">
          `
        : `
           <select name="variantColor[]" required class="ant-input" style="font-size:13px;">
             <option value="">--Màu--</option>
             ${colorsRes.map(c => `
               <option value="${c._id}" ${c._id === (variant.color?._id || variant.color) ? 'selected' : ''}>
                 ${c.name}
               </option>`).join("")}
           </select>
          `}
    </td>

    <td data-label="Size">
      ${isEditingExisting
        ? `
           <span>${variant.size?.name || 'N/A'}</span>
           <input type="hidden" name="variantSize[]" value="${variant.size?._id || variant.size || ''}">
           <input type="hidden" name="existingVariantSize[]" value="${variant.size?._id || variant.size || ''}">
          `
        : `
           <select name="variantSize[]" required class="ant-input" style="font-size:13px;">
             <option value="">--Size--</option>
             ${sizesRes.map(s => `
               <option value="${s._id}" ${s._id === (variant.size?._id || variant.size) ? 'selected' : ''}>
                 ${s.name}
               </option>`).join("")}
           </select>
          `}
    </td>

    <td data-label="Số lượng">
      <input type="number" name="variantStock[]" value="${variant.stockQuantity || 0}" min="0" class="ant-input" required>
    </td>

    <td data-label="Giá">
      <input type="number" name="variantPrice[]" value="${variant.price || 0}" min="1" step="1" class="ant-input" required>
    </td>

    <td data-label="Ảnh" style="position:relative;">
      <div class="image-preview" style="margin-top:4px; display:flex; flex-wrap:wrap; gap:6px; max-height:80px; overflow-y:auto;"></div>
      <input type="file" name="variantImageFile[${rowIndex}]" accept="image/*" multiple class="variant-file-input" style="margin-top:4px;">
      <small style="color:#999; font-size:10px;">Tối đa 6 ảnh</small>
    </td>

    <td data-label="Hành động">
      <button type="button" class="btn-remove">Xóa</button>
    </td>
  `;

  body.appendChild(row);

  // ====== ẢNH CÓ SẴN ======
  const preview = row.querySelector(".image-preview");
  currentImages.forEach((src, idx) => {
    const div = document.createElement("div");
    div.className = "image-item";
    div.style.position = "relative";
    div.innerHTML = `
      <img src="${src}" data-original="${src}"
        style="width:40px;height:40px;object-fit:cover;border:${idx===0?'2px solid #ff6b6b':'1px solid #ddd'};border-radius:4px;">
      <button type="button" class="remove-img"
        style="position:absolute;top:0;right:0;background:red;color:white;border:none;width:16px;height:16px;font-size:10px;border-radius:50%;">x</button>
      ${idx === 0 ? '<div style="position:absolute;top:2px;left:2px;background:#ff6b6b;color:white;font-size:8px;padding:1px 4px;border-radius:2px;">BÌA</div>' : ''}
      <input type="hidden" name="keepImages[]" value="${src}">
    `;
    div.querySelector(".remove-img").onclick = () => {
      const input = div.querySelector("input[name='keepImages[]']");
      if (input) {
        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = "removeImages[]";
        hidden.value = input.value;
        div.parentElement.appendChild(hidden);
      }
      div.remove();
    };
    preview.appendChild(div);
  });

  // ====== UPLOAD ẢNH MỚI ======
  const fileInput = row.querySelector(".variant-file-input");
  if (fileInput) {
    fileInput.onchange = () => {
      const files = Array.from(fileInput.files);
      const currentCount = preview.querySelectorAll(".image-item").length;
      if (currentCount + files.length > maxImages) {
        showToast("Tối đa 6 ảnh!", "error");
        fileInput.value = "";
        return;
      }
      files.forEach(file => {
        const reader = new FileReader();
        reader.onload = e => {
          const div = document.createElement("div");
          div.className = "image-item";
          div.style.position = "relative";
          div.innerHTML = `
            <img src="${e.target.result}" style="width:40px;height:40px;object-fit:cover;border:1px solid #ddd;border-radius:4px;">
            <button type="button" class="remove-img"
              style="position:absolute;top:0;right:0;background:red;color:white;border:none;width:16px;height:16px;font-size:10px;border-radius:50%;">x</button>
          `;
          div.querySelector(".remove-img").onclick = () => div.remove();
          preview.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    };
  }

  // ====== XÓA VARIANT ======
  row.querySelector(".btn-remove").onclick = () => row.remove();
}

