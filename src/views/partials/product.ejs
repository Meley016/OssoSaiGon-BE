  function doExport(type) {
    const mode = document.querySelector(
      "input[name='export-mode']:checked"
    )?.value;

    const params = new URLSearchParams({
      type,
      mode
    });

    // ===== MODE: SELECTED =====
    if (mode === "selected") {
      if (!selectedProductIds.length) {
        return showToast("Chưa chọn sản phẩm nào!", "error");
      }
      params.append("ids", selectedProductIds.join(","));
    }

    // ===== MODE: FILTERED =====
    if (mode === "filtered") {
      Object.entries(currentFilters || {}).forEach(([k, v]) => {
        if (v) params.append(k, v);
      });
    }

    // ===== MODE: ALL =====
    // không cần append gì thêm

    window.location.href = `/api/products/export?${params.toString()}`;
  }

document.getElementById("select-all-visible")?.addEventListener("change", e => {
