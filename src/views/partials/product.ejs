function openExportModal() {
  document.getElementById("export-count").innerText =
    selectedProductIds.length;

  // auto chọn mode theo context
  if (!selectedProductIds.length) {
    document.querySelector("input[value='filtered']").checked = true;
  }

  document.getElementById("exportModal").style.display = "block";
}
async function loadProductReviews(productId) {
  const body = document.getElementById("reviewBody");
  body.innerHTML = `<tr><td colspan="5">Đang tải...</td></tr>`;

  try {
    const res = await fetch(`/api/reviews/admin/product/${productId}`);
    if (!res.ok) throw new Error("Không thể tải review");

    const reviews = await res.json();

    if (!reviews.length) {
      body.innerHTML = `<tr><td colspan="5">Chưa có đánh giá</td></tr>`;
      return;
    }

    body.innerHTML = reviews.map(r => `
      <tr>
        <td>${r.user?.name || "Ẩn danh"}<br><small>${r.user?.email || ""}</small></td>
        <td>${"⭐".repeat(r.rating)}</td>
        <td style="max-width:260px;word-break:break-word;">
          ${r.comment || "<i>(Không có nội dung)</i>"}
        </td>
        <td>${new Date(r.createdAt).toLocaleDateString()}</td>
        <td>
          <button
            class="btn-reset"
            onclick="deleteReview('${r._id}','${productId}')"
          >
            Xóa
          </button>
        </td>
      </tr>
    `).join("");

  } catch (err) {
    body.innerHTML = `<tr><td colspan="5">Lỗi tải review</td></tr>`;
  }
}

async function deleteReview(reviewId, productId) {
  if (!confirm("Xóa bình luận này?")) return;

  showLoading("Đang xóa review...");

  try {
    const res = await fetch(`/api/reviews/admin/${reviewId}`, {
      method: "DELETE"
    });

    if (!res.ok) throw new Error("Xóa thất bại");

    showToast("Đã xóa review");
    loadProductReviews(productId);

  } catch (err) {
    showToast(err.message, "error");
  } finally {
    hideLoading();
  }
}

