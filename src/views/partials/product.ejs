function groupVariantsByColor(variants) {
  const map = {};

  variants.forEach(v => {
    const colorId = v.color._id;
    if (!map[colorId]) {
      map[colorId] = {
        color: v.color,
        images: v.images || [],
        variants: []
      };
    }
    map[colorId].variants.push(v);
  });

  return Object.values(map);
}

// === DOMContentLoaded ===
document.addEventListener("DOMContentLoaded", async () => {
  [categoriesRes, colorsRes, sizesRes] = await Promise.all([
    fetch('/api/categories').then(r => r.ok ? r.json() : []),
    fetch('/api/colors').then(r => r.ok ? r.json() : []),
    fetch('/api/sizes').then(r => r.ok ? r.json() : [])
  ]);

  const fillSelect = (id, items, placeholder = "") => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = placeholder + items.map(i => `<option value="${i._id}">${i.name}</option>`).join('');
  };
  fillSelect("categorySelect", categoriesRes, '<option value="">--Chọn danh mục--</option>');
  fillSelect("edit-category", categoriesRes);
  fillSelect("filter-category", categoriesRes, '<option value="">--Tất cả danh mục--</option>');

  // Nút thêm biến thể (form tạo)
  document.getElementById("addVariant")?.addEventListener("click", () => {
    addVariantRow(document.getElementById("variantBody"));
  });

  // === TẠO SẢN PHẨM ===
  document.getElementById("product-form").onsubmit = async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    formData.delete("variants");

    const variants = [];
    const rows = document.querySelectorAll("#variantBody tr");

    if (!rows.length) return showToast("Cần ít nhất 1 biến thể!", "error");

    const uploadedColors = new Set();
      rows.forEach((row) => {
        const color = row.querySelector("select[name='variantColor[]']").value;
        const size = row.querySelector("select[name='variantSize[]']").value;
        const stock = row.querySelector("input[name='variantStock[]']").value;
        const price = row.querySelector("input[name='variantPrice[]']").value;

        if (color && size && price > 0) {
          variants.push({ color, size, stock: Number(stock), price: Number(price) });

          // 🟢 Chỉ upload ảnh 1 lần cho mỗi colorId
          if (!uploadedColors.has(color)) {
            const fileInput = row.querySelector("input[type='file']");
            const files = Array.from(fileInput.files);
            files.forEach(f => formData.append(`variantImageFile[${color}]`, f));
            uploadedColors.add(color);
          }
        }
      });

    if (!variants.length) return showToast("Cần ít nhất 1 biến thể hợp lệ!", "error");

    formData.append("variants", JSON.stringify(variants));
    
    showLoading("Đang tạo sản phẩm...");
    
    try {
      const res = await fetch("/api/products", { method: "POST", body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Lỗi tạo");
      showToast("Tạo thành công!");
      e.target.reset();
      document.getElementById("variantBody").innerHTML = "";
      loadProducts();
      } catch (err) {
        showToast("Lỗi: " + err.message, "error");
      } finally {
      hideLoading();
    };
  };



  // === IMPORT CSV ===
  document.getElementById("csv-import-form").onsubmit = async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const btn = e.target.querySelector("button[type='submit']");
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Đang nhập...";
    console.log("Import FormData:", Array.from(formData.entries()).map(([k, v]) => [k, v instanceof File ? v.name : v]));

    showLoading("Đang import dữ liệu...");

    try {
      const res = await fetch("/api/products/import", { method: "POST", body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Lỗi import");
      showToast(`Nhập thành công! Tạo: ${data.results.created}, Cập nhật: ${data.results.updated}`);
      e.target.reset();
      loadProducts();
    } catch (err) {
      showToast("Lỗi: " + err.message);
    }
    finally {
    // 🟢 Kết thúc loading
    hideLoading();
    btn.disabled = false;
    btn.textContent = originalText;
  }
  };


  // === LỌC ===
  document.getElementById("btn-filter").onclick = () => {
    currentPage = 1;
    currentFilters = {
      name: document.getElementById("filter-name").value.trim(),
      category: document.getElementById("filter-category").value,
      brand: document.getElementById("filter-brand").value.trim(),
      minQuantity: document.getElementById("filter-min-quantity").value
    };
    loadProducts(currentFilters);
  };

  document.getElementById("btn-reset-filter").onclick = () => {
    document.querySelectorAll(".filter-grid input, .filter-grid select").forEach(el => el.value = "");
    currentFilters = {};
    currentPage = 1;
    loadProducts();
  };

  // === LOAD PRODUCTS ===
  window.loadProducts = async (filters = {}, page = 1) => {
  currentPage = page;

  const params = new URLSearchParams({ ...filters, page, limit });
  const grid = document.getElementById("productGrid");

  /* =====================
     SHOW SKELETON
  ===================== */
  grid.innerHTML = Array.from({ length: limit }).map(() => `
    <div class="product-card skeleton">
      <div class="img"></div>
      <div class="line"></div>
      <div class="line short"></div>
    </div>
  `).join("");

  try {
    const res = await fetch(`/api/products?${params}`);
    if (!res.ok) throw new Error("Lỗi tải sản phẩm");

    const data = await res.json();
    const products = Array.isArray(data.data) ? data.data : [];

    grid.innerHTML = "";

    if (!products.length) {
      grid.innerHTML = '<p style="text-align:center;padding:20px;">Chưa có sản phẩm nào.</p>';
      return;
    }

    /* =====================
       RENDER TỪNG PRODUCT
    ===================== */
    for (const p of products) {
      const variants = Array.isArray(p.variants) ? p.variants : [];
      const safeVariants = variants.filter(
        v => v && v.color && v.color._id && typeof v.price === "number"
      );

      const prices = safeVariants.map(v => v.price);
      const minPrice = prices.length ? Math.min(...prices) : 0;

      const uniqueColors = [
        ...new Map(
          safeVariants
            .filter(v => v.color && v.color._id)
            .map(v => [v.color._id, v.color])
        ).values()
      ];

      const colorCount = uniqueColors.length;
      const extra = colorCount > 4 ? colorCount - 4 : 0;

      const card = document.createElement("div");
      card.className = "product-card";
      card.onclick = () => {
        if (document.querySelector(".product-checkbox:checked")) return;
        showProductDetail(p._id);
      };

      card.innerHTML = `
      <label style="position:absolute;top:8px;left:8px;z-index:2;">
        <input
          type="checkbox"
          class="product-checkbox"
          data-id="${p._id}"
          ${selectedProductIds.includes(p._id) ? "checked" : ""}
          onclick="event.stopPropagation()"
        />
      </label>
        <img
          loading="lazy"
          src="${p.coverImage || '/imgs/placeholder.jpg'}"
          onerror="this.src='/imgs/placeholder.jpg'"
        />
        <h4>${p.name}</h4>
        <p class="sku">SKU: ${p.groupId}</p>
        <p class="price-display">${minPrice.toLocaleString()} VNĐ</p>
        <div class="color-dots">
          ${uniqueColors.slice(0, 4).map(c =>
            `<div title="${c.name}" class="dot" style="background:${c.code || '#ddd'}"></div>`
          ).join("")}
          ${extra > 0 ? `<div class="dot more">+${extra}</div>` : ""}
        </div>
        <div class="product-card-actions">
          <button class="btn-edit">Sửa</button>
          <button class="btn-delete">Xóa</button>
        </div>
      `;

      card.querySelector(".btn-edit").onclick = e => {
        e.stopPropagation();
        editProduct(p._id);
      };

      card.querySelector(".btn-delete").onclick = e => {
        e.stopPropagation();
        deleteProduct(p._id);
      };

      grid.appendChild(card);
    }
      const selectAll = document.getElementById("select-all-visible");
      if (selectAll) selectAll.checked = false;
    /* =====================
       PAGINATION
    ===================== */
    const totalPages = data.pagination?.totalPages || 1;
    renderPagination(page, totalPages);

  } catch (err) {
    console.error(err);
    grid.innerHTML = '<p style="text-align:center;padding:20px;">Lỗi tải sản phẩm!</p>';
  }
};

