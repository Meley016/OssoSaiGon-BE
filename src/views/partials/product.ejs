<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/antd@5.12.0/dist/reset.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/antd@5.12.0/dist/antd.min.css" />
<link rel="stylesheet" href="/css/globe.css">

<div class="product-container">

  <!-- TẠO SẢN PHẨM -->
  <div class="form-section">
    <h2 style="margin-bottom: 1rem;">Quản lý Sản phẩm</h2>

    <h3>Tạo sản phẩm mới</h3>
    <form id="product-form" enctype="multipart/form-data" method="POST" action="/api/products">
      <div class="form-grid">
        <input type="text" name="SKU" placeholder="SKU" class="ant-input" required />
        <select name="category" id="categorySelect" class="ant-input" required>
          <option value="">--Chọn danh mục--</option>
        </select>
        <input type="text" name="brand" placeholder="Thương hiệu" class="ant-input" required />
        <input type="text" name="name" placeholder="Tên sản phẩm" class="ant-input" required />
        <textarea name="description" placeholder="Mô tả" class="ant-input" rows="2"></textarea>
      </div>

      <!-- BIẾN THỂ -->
      <div class="form-section">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h3>Biến thể sản phẩm</h3>
          <button type="button" id="addVariant" class="btn-custom" style="width:auto; padding:6px 12px;">Thêm</button>
        </div>
        <table class="variant-table" style="width:100%; margin-top:10px;">
          <thead>
            <tr>
              <th>Màu</th>
              <th>Size</th>
              <th>Số lượng</th>
              <th>Giá</th>
              <th>Ảnh</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody id="variantBody"></tbody>
        </table>
      </div>

      <div class="button-row">
        <button type="submit" class="btn-custom">Tạo sản phẩm</button>
        <button type="reset" class="btn-reset">Đặt lại</button>
      </div>
    </form>
  </div>

  <!-- Import CSV -->
  <div class="form-section">
    <h3>Nhập từ CSV</h3>
    <form id="csv-import-form" enctype="multipart/form-data" method="POST" action="/api/products/import">
      <div class="form-grid">
        <input type="file" name="csvFile" accept=".csv,.xlsx" class="ant-input" required />
      </div>
      <div class="button-row">
        <button type="submit" class="btn-custom">Import</button>
      </div>
    </form>
  </div>

  <!-- Lọc -->
  <div class="form-section">
    <h3>Lọc sản phẩm</h3>
    <div class="form-grid filter-grid">
      <input type="text" id="filter-name" placeholder="Tên sản phẩm" class="ant-input" />
      <select id="filter-category" class="ant-input">
        <option value="">--Tất cả danh mục--</option>
      </select>
      <input type="text" id="filter-brand" placeholder="Thương hiệu" class="ant-input" />
      <input type="number" id="filter-min-quantity" placeholder="SL tối thiểu" class="ant-input" min="0" />
      <button id="btn-filter" class="btn-custom">Lọc</button>
      <button id="btn-reset-filter" class="btn-reset">Xóa lọc</button>
    </div>
  </div>

  <!-- Danh sách -->
  <div id="productGrid" class="product-grid"></div>
  <div id="pagination" class="pagination"></div>
</div>

<!-- Modal Edit -->
<div id="editModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeEditModal()">&times;</span>
    <h3>Sửa sản phẩm</h3>
    <form id="edit-form" enctype="multipart/form-data" method="POST">
      <input type="hidden" id="edit-id" name="id" />
      <input type="hidden" name="keepExistingImages" value="true" />
      <div class="form-grid">
        <input type="text" id="edit-SKU" name="SKU" required class="ant-input" />
        <select id="edit-category" name="category" class="ant-input" required></select>
        <input type="text" id="edit-brand" name="brand" required class="ant-input" />
        <input type="text" id="edit-name" name="name" required class="ant-input" />
        <textarea id="edit-description" name="description" class="ant-input" rows="4"></textarea>
      </div>
      <div class="variant-section">
        <h4>Biến thể</h4>
        <button type="button" id="edit-addVariant" class="btn-custom">Thêm</button>
        <table class="variant-table">
          <thead>
            <tr>
              <th>Màu</th>
              <th>Size</th>
              <th>SL</th>
              <th>Giá</th>
              <th>Ảnh</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="editVariantBody"></tbody>
        </table>
      </div>
      <div style="text-align:right;margin-top:20px;">
        <button type="button" class="btn-reset" onclick="closeEditModal()">Hủy</button>
        <button type="submit" class="btn-custom">Cập nhật</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Detail -->
<div id="detailModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeDetailModal()">&times;</span>
    <h3>Chi tiết sản phẩm</h3>
    <div id="detail-content">
      <div class="form-grid">
        <p><strong>SKU:</strong> <span id="detail-SKU"></span></p>
        <p><strong>Danh mục:</strong> <span id="detail-category"></span></p>
        <p><strong>Thương hiệu:</strong> <span id="detail-brand"></span></p>
        <p><strong>Tên sản phẩm:</strong> <span id="detail-name"></span></p>
        <p><strong>Mô tả:</strong> <span id="detail-description"></span></p>
      </div>
      <div class="variant-section">
        <h4>Biến thể</h4>
        <table class="variant-table">
          <thead>
            <tr>
              <th>Màu</th>
              <th>Size</th>
              <th>Số lượng</th>
              <th>Giá</th>
              <th>Ảnh</th>
            </tr>
          </thead>
          <tbody id="detailVariantBody"></tbody>
        </table>
      </div>
      <div style="text-align:right;margin-top:20px;">
        <button type="button" class="btn-reset" onclick="closeDetailModal()">Đóng</button>
      </div>
    </div>
  </div>
</div>
<div id="toastContainer" class="toast-container"></div>

<script>
let colorsRes = [], sizesRes = [], categoriesRes = [];
let currentFilters = {};
let currentPage = 1;
const limit = 10;

// === THÊM BIẾN THỂ ===
function addVariantRow(body, variant = {}, isEdit = false) {
  const rowIndex = body.children.length;
  const maxImages = 6;
  const currentImages = variant.images || [];

  const row = document.createElement("tr");
  row.innerHTML = `
    <td data-label="Màu">
      <select name="variantColor[]" required class="ant-input" style="font-size:13px;">
        <option value="">--Màu--</option>
        ${colorsRes.map(c => `<option value="${c._id}" ${c._id === (variant.color?._id || variant.color) ? 'selected' : ''}>${c.name}</option>`).join("")}
      </select>
    </td>
    <td data-label="Size">
      <select name="variantSize[]" required class="ant-input" style="font-size:13px;">
        <option value="">--Size--</option>
        ${sizesRes.map(s => `<option value="${s._id}" ${s._id === (variant.size?._id || variant.size) ? 'selected' : ''}>${s.name}</option>`).join("")}
      </select>
    </td>
    <td data-label="Số lượng"><input type="number" name="variantStock[]" value="${variant.quantity || 0}" min="0" class="ant-input" required></td>
    <td data-label="Giá"><input type="number" name="variantPrice[]" value="${variant.price || 0}" min="1" step="1" class="ant-input" required></td>
    <td data-label="Ảnh" style="position:relative;">
      <input type="file" name="" accept="image/*" multiple class="variant-file-input">
      <div class="image-preview" style="margin-top:4px; display:flex; flex-wrap:wrap; gap:6px; max-height:80px; overflow-y:auto;"></div>
      <small style="color:#999; font-size:10px;">Tối đa 6 ảnh</small>
    </td>
    <td data-label="Hành động"><button type="button" class="btn-remove">Xóa</button></td>
  `;

  body.appendChild(row);

  const fileInput = row.querySelector("input[type='file']");
  const preview = row.querySelector(".image-preview");

  currentImages.forEach((src, idx) => {
    const div = document.createElement("div");
    div.className = "image-item";
    div.style.position = "relative";
    div.innerHTML = `
      <img src="${src}" data-original="${src}" style="width:40px; height:40px; object-fit:cover; border:${idx===0?'2px solid #ff6b6b':'1px solid #ddd'}; border-radius:4px;">
      <button type="button" style="position:absolute; top:0; right:0; background:red; color:white; border:none; width:16px; height:16px; font-size:10px; border-radius:50%;">x</button>
      ${idx === 0 ? '<div style="position:absolute; top:2px; left:2px; background:#ff6b6b; color:white; font-size:8px; padding:1px 4px; border-radius:2px;">BÌA</div>' : ''}
    `;
    div.querySelector("button").onclick = () => { div.remove(); updateCover(); };
    preview.appendChild(div);
  });

  const updateCover = () => {
    const items = preview.querySelectorAll(".image-item");
    items.forEach((item, i) => {
      const img = item.querySelector("img");
      const badge = item.querySelector("div");
      img.style.border = i === 0 ? "2px solid #ff6b6b" : "1px solid #ddd";
      if (i === 0 && !badge) {
        const newBadge = document.createElement("div");
        newBadge.textContent = "BÌA";
        newBadge.style.cssText = "position:absolute; top:2px; left:2px; background:#ff6b6b; color:white; font-size:8px; padding:1px 4px; border-radius:2px;";
        item.appendChild(newBadge);
      } else if (i !== 0 && badge) {
        badge.remove();
      }
    });
    fileInput.disabled = items.length >= maxImages;
  };
  updateCover();

  fileInput.onchange = null; 
  fileInput.onchange = () => {
    const files = Array.from(fileInput.files);
    const currentCount = preview.querySelectorAll(".image-item").length;
    if (currentCount + files.length > 6) {
      showToast("Tối đa 6 ảnh!");
      fileInput.value = "";
      return;
    }

    files.forEach(file => {
      const reader = new FileReader();
      reader.onload = e => {
        const div = document.createElement("div");
        div.className = "image-item";
        div.style.position = "relative";
        div.innerHTML = `
          <img src="${e.target.result}" style="width:40px;height:40px;object-fit:cover;border:1px solid #ddd;border-radius:4px;">
          <button type="button" style="position:absolute;top:0;right:0;background:red;color:white;border:none;width:16px;height:16px;font-size:10px;border-radius:50%;">x</button>
        `;
        div.querySelector("button").onclick = () => {
          div.remove();
          updateCover();
        };
        preview.appendChild(div);
        updateCover();
      };
      reader.readAsDataURL(file);
    });
  }

  row.querySelector(".btn-remove").onclick = () => row.remove();
}

// === DOMContentLoaded ===
document.addEventListener("DOMContentLoaded", async () => {
  [categoriesRes, colorsRes, sizesRes] = await Promise.all([
    fetch('/api/categories').then(r => r.ok ? r.json() : []),
    fetch('/api/colors').then(r => r.ok ? r.json() : []),
    fetch('/api/sizes').then(r => r.ok ? r.json() : [])
  ]);

  const fillSelect = (id, items, placeholder = "") => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = placeholder + items.map(i => `<option value="${i._id}">${i.name}</option>`).join('');
  };
  fillSelect("categorySelect", categoriesRes, '<option value="">--Chọn danh mục--</option>');
  fillSelect("edit-category", categoriesRes);
  fillSelect("filter-category", categoriesRes, '<option value="">--Tất cả danh mục--</option>');

  // Nút thêm biến thể (form tạo)
  document.getElementById("addVariant")?.addEventListener("click", () => {
    addVariantRow(document.getElementById("variantBody"));
  });

  // === TẠO SẢN PHẨM ===
  document.getElementById("product-form").onsubmit = async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    formData.delete("variants");

    const variants = [];
    const rows = document.querySelectorAll("#variantBody tr");

    if (!rows.length) return showToast("Cần ít nhất 1 biến thể!", "error");

    const uploadedColors = new Set();
      rows.forEach((row) => {
        const color = row.querySelector("select[name='variantColor[]']").value;
        const size = row.querySelector("select[name='variantSize[]']").value;
        const stock = row.querySelector("input[name='variantStock[]']").value;
        const price = row.querySelector("input[name='variantPrice[]']").value;

        if (color && size && price > 0) {
          variants.push({ color, size, stock: Number(stock), price: Number(price) });

          // 🟢 Chỉ upload ảnh 1 lần cho mỗi colorId
          if (!uploadedColors.has(color)) {
            const fileInput = row.querySelector("input[type='file']");
            const files = Array.from(fileInput.files);
            files.forEach(f => formData.append(`variantImageFile[${color}]`, f));
            uploadedColors.add(color);
          }
        }
      });

    if (!variants.length) return showToast("Cần ít nhất 1 biến thể hợp lệ!", "error");

    formData.append("variants", JSON.stringify(variants));

    try {
      const res = await fetch("/api/products", { method: "POST", body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Lỗi tạo");
      showToast("Tạo thành công!");
      e.target.reset();
      document.getElementById("variantBody").innerHTML = "";
      loadProducts();
    } catch (err) {
      showToast("Lỗi: " + err.message, "error");
    }
  };



  // === IMPORT CSV ===
  document.getElementById("csv-import-form").onsubmit = async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    console.log("Import FormData:", Array.from(formData.entries()).map(([k, v]) => [k, v instanceof File ? v.name : v])); // Debug
    try {
      const res = await fetch("/api/products/import", { method: "POST", body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Lỗi import");
      showToast(`Nhập thành công! Tạo: ${data.results.created}, Cập nhật: ${data.results.updated}`);
      e.target.reset();
      loadProducts();
    } catch (err) {
      showToast("Lỗi: " + err.message);
    }
  };

  // === LỌC ===
  document.getElementById("btn-filter").onclick = () => {
    currentPage = 1;
    currentFilters = {
      name: document.getElementById("filter-name").value.trim(),
      category: document.getElementById("filter-category").value,
      brand: document.getElementById("filter-brand").value.trim(),
      minQuantity: document.getElementById("filter-min-quantity").value
    };
    loadProducts(currentFilters);
  };

  document.getElementById("btn-reset-filter").onclick = () => {
    document.querySelectorAll(".filter-grid input, .filter-grid select").forEach(el => el.value = "");
    currentFilters = {};
    currentPage = 1;
    loadProducts();
  };

  // === LOAD PRODUCTS ===
  window.loadProducts = async (filters = {}, page = 1) => {
    currentPage = page;
    const params = new URLSearchParams({ ...filters, page, limit });
    try {
      const res = await fetch(`/api/products?${params}`);
      if (!res.ok) throw new Error("Lỗi tải sản phẩm");
      const data = await res.json();

      const grid = document.getElementById("productGrid");
      grid.innerHTML = (data.data || []).map(p => {
        const variants = Array.isArray(p.variants) ? p.variants : [];
        const safeVariants = variants.filter(v => v && v.color && v.color._id && typeof v.price === "number");
        const prices = safeVariants.map(v => v.price);
        const minPrice = prices.length ? Math.min(...prices) : 0;
        const uniqueColors = [...new Map(safeVariants.filter(v => v.color && v.color._id).map(v => [v.color._id, v.color])).values()];
        const colorCount = uniqueColors.length;
        const gridCols = Math.min(colorCount, 4);
        const extra = colorCount > 4 ? colorCount - 4 : 0;

        return `
          <div class="product-card" onclick="showProductDetail('${p._id}')">
            <img src="${p.coverImage || '/imgs/placeholder.jpg'}" onerror="this.src='/imgs/placeholder.jpg'" />
            <h4>${p.name}</h4>
            <p class="sku">SKU: ${p.groupId}</p>
            <p class="price-display">${minPrice.toLocaleString()} VNĐ</p>
            <div class="color-dots">
              ${uniqueColors.slice(0, 4).map(c => `<div title="${c.name}" class="dot" style="background:${c.code || '#ddd'}"></div>`).join("")}
              ${extra > 0 ? `<div class="dot more">+${extra}</div>` : ""}
            </div>
            <div class="product-card-actions">
              <button onclick="event.stopPropagation(); editProduct('${p._id}')" class="btn-edit">Sửa</button>
              <button onclick="event.stopPropagation(); deleteProduct('${p._id}')" class="btn-delete">Xóa</button>
            </div>
          </div>
        `;
      }).join("") || '<p style="text-align:center;padding:20px;">Chưa có sản phẩm nào.</p>';

      const pagination = document.getElementById("pagination");
      const totalPages = data.pagination?.totalPages || 1;
      pagination.innerHTML = totalPages ? Array.from({ length: totalPages }, (_, i) => `
        <button class="${i + 1 === page ? 'active' : ''}" onclick="loadProducts(currentFilters, ${i + 1})">${i + 1}</button>
      `).join("") : "";
    } catch (err) {
      document.getElementById("productGrid").innerHTML = '<p style="text-align:center;padding:20px;">Lỗi tải sản phẩm!</p>';
    }
  };

  // === CHI TIẾT SẢN PHẨM ===
  window.showProductDetail = async (id) => {
    try {
      const res = await fetch(`/api/products/${id}`);
      if (!res.ok) throw new Error("Lỗi tải chi tiết");
      const p = await res.json();

      document.getElementById("detail-SKU").textContent = p.groupId || "N/A";
      document.getElementById("detail-category").textContent = p.category?.name || "N/A";
      document.getElementById("detail-brand").textContent = p.brand || "N/A";
      document.getElementById("detail-name").textContent = p.name || "N/A";
      document.getElementById("detail-description").textContent = p.description || "Không có mô tả";

      const variantBody = document.getElementById("detailVariantBody");
      variantBody.innerHTML = (p.variants || []).map(v => {
        if (!v.color || !v.size) return "";
        return `
          <tr>
            <td data-label="Màu">${v.color.name}</td>
            <td data-label="Size">${v.size.name}</td>
            <td data-label="Số lượng">${v.stockQuantity}</td>
            <td data-label="Giá">${v.price.toLocaleString()} VNĐ</td>
            <td data-label="Ảnh">
              <div class="image-preview" style="display:flex; flex-wrap:wrap; gap:6px;">
                ${(v.images || []).map(i => `<img src="${i}" style="width:40px; height:40px; object-fit:cover; border-radius:4px;">`).join("")}
              </div>
            </td>
          </tr>
        `;
      }).join("") || '<tr><td colspan="5">Không có biến thể</td></tr>';

      document.getElementById("detailModal").style.display = "block";
    } catch (err) {
      showToast("Lỗi: " + err.message);
    }
  };

  window.closeDetailModal = () => document.getElementById("detailModal").style.display = "none";

  // === SỬA SẢN PHẨM ===
  window.editProduct = async id => {
    try {
      const res = await fetch(`/api/products/${id}`);
      if (!res.ok) throw new Error("Lỗi tải sản phẩm");
      const p = await res.json();

      document.getElementById('edit-id').value = p._id;
      document.getElementById('edit-SKU').value = p.groupId;
      document.getElementById('edit-category').value = p.category?._id || '';
      document.getElementById('edit-brand').value = p.brand;
      document.getElementById('edit-name').value = p.name;
      document.getElementById('edit-description').value = p.description || '';

      const body = document.getElementById("editVariantBody");
      body.innerHTML = "";
      p.variants.forEach(v => addVariantRow(body, v, true));

      document.getElementById('editModal').style.display = 'block';

      // Gắn lại sự kiện cho nút thêm biến thể
      setTimeout(() => {
        const btn = document.getElementById("edit-addVariant");
        if (btn) btn.onclick = () => addVariantRow(document.getElementById("editVariantBody"), {}, true);
      }, 100);
    } catch (err) {
      showToast("Lỗi: " + err.message);
    }
  };

  // === CẬP NHẬT ===
  document.getElementById("edit-form").onsubmit = async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const id = document.getElementById("edit-id").value;

    // Xóa field cũ
    for (const key of Array.from(formData.keys())) {
      if (key.includes('[')) formData.delete(key);
    }

    const rows = document.querySelectorAll("#editVariantBody tr");
    let hasVariant = false;

    rows.forEach((row, i) => {
      const fileInput = row.querySelector("input[type='file']");
      for (const f of fileInput.files) {
        formData.append(`variantImageFile[${i}]`, f);
      }

      const existingId = row.querySelector("input[name*='existingVariantId']");
      if (existingId) {
        formData.append(`existingVariantId[${i}]`, existingId.value);
        const price = row.querySelector("input[name*='Price']")?.value;
        const stock = row.querySelector("input[name*='Stock']")?.value;
        if (price) formData.append(`variantPrice[${i}]`, price);
        if (stock) formData.append(`variantStock[${i}]`, stock);
        hasVariant = true;
      }

      const newColor = row.querySelector("select[name*='newVariantColor']");
      if (newColor) {
        const color = newColor.value;
        const size = row.querySelector("select[name*='newVariantSize']").value;
        const price = row.querySelector("input[name*='newVariantPrice']").value;
        const stock = row.querySelector("input[name*='newVariantStock']").value;
        if (color && size && price > 0) {
          formData.append(`newVariantColor[${i}]`, color);
          formData.append(`newVariantSize[${i}]`, size);
          formData.append(`newVariantPrice[${i}]`, price);
          formData.append(`newVariantStock[${i}]`, stock);
          hasVariant = true;
        }
      }
    });

    if (!hasVariant) return showToast("Cần ít nhất 1 biến thể!", "error");

    ['SKU', 'name', 'brand', 'category', 'description'].forEach(f => {
      const val = document.getElementById(`edit-${f}`).value.trim();
      if (val) formData.append(f, val);
    });

    const res = await fetch(`/api/products/${id}`, { method: "PUT", body: formData });
    const data = await res.json();
    if (!res.ok) return showToast(data.error || "Lỗi cập nhật", "error");

    showToast("Cập nhật thành công!");
    closeEditModal();
    loadProducts();
  };



  window.closeEditModal = () => document.getElementById('editModal').style.display = 'none';

  window.deleteProduct = async id => {
    if (!confirm("Xóa sản phẩm này?")) return;
    try {
      const res = await fetch(`/api/products/${id}`, { method: "DELETE" });
      if (!res.ok) throw new Error("Lỗi xóa sản phẩm");
      showToast("Xóa thành công!");
      loadProducts(currentFilters, currentPage);
    } catch (err) {
      showToast("Lỗi: " + err.message);
    }
  };

  loadProducts();
});
function showToast(message, type = "success", duration = 5000) {
  const container = document.getElementById("toastContainer");
  const toast = document.createElement("div");
  toast.className = `toast ${type}`;

  const icons = {
    success: "✅",
    error: "❌",
    info: "ℹ️"
  };

  toast.innerHTML = `${icons[type]} ${message}`;
  container.appendChild(toast);

  setTimeout(() => {
    toast.style.opacity = "0";
    toast.style.transform = "translateX(120%)";
    setTimeout(() => toast.remove(), 300);
  }, duration);
}

</script>