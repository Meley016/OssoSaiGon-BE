<style>
/* ====== NOTIFY ITEM ====== */
.notify-item { 
  margin-bottom: 10px; 
  padding: 10px; 
  border-radius: 6px; 
  background: #fff; 
  display: flex; 
  flex-direction: column;
}

.notify-item.unseen { border: 1px solid #fca5a5; }

/* ====== HEADER ====== */
.notify-header { 
  display: flex; 
  flex-direction: column; 
  justify-content: space-between; 
  align-items: flex-start; 
  cursor: pointer; 
}

.notify-header .header-top {
  display: flex; 
  flex-wrap: wrap; 
  justify-content: space-between; 
  width: 100%;
  gap: 10px;
}

.notify-header strong {
  font-size: 14px;
}

.notify-header .badge-date {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 5px;
  flex-wrap: wrap;
}

/* ====== DETAILS ====== */
.details-wrapper { 
  display: none; 
  margin-top: 8px; 
  width: 100%;
  overflow-x: auto;
}

.details-table { 
  width: 100%; 
  min-width: 700px; 
  border-collapse: collapse; 
}

.details-table th, .details-table td { 
  border: 1px solid #ddd; 
  padding: 6px 8px; 
  font-size: 13px; 
  text-align: left;
}

.details-table th { 
  background: #ffe6e6; 
  font-weight: 600; 
}

/* ====== BADGE ====== */
.badge-mini { 
  border: none; 
  cursor: pointer; 
  padding: 4px 10px; 
  border-radius: 999px; 
  font-size: 12px; 
  font-weight: 600; 
}

.badge-mini.pending { background: #fde68a; color: #92400e; }
.badge-mini.done { background: #bbf7d0; color: #065f46; }

/* ====== EXPORT BUTTON ====== */
.export-btn { 
  margin-bottom: 15px; 
  padding: 6px 12px; 
  background: black; 
  color: white; 
  cursor: pointer; 
  border-radius: 4px; 
  font-weight: 600; 
}
.export-btn:hover { background: #ffe6e6; color: black; }

/* ====== RESPONSIVE ====== */
@media (max-width: 600px) {
  .notify-header .header-top {
    flex-direction: column;
    align-items: flex-start;
  }
  .details-table { min-width: 100%; }
}
</style>

<button class="export-btn" onclick="exportPreorders()">Export Preorders CSV</button>

<div class="notify-list">
  <% if (!preorders.length) { %>
    <p class="empty">Không có preorder mới</p>
  <% } %>

  <% preorders.forEach(p => { %>
    <div class="notify-item <%= !p.isSeen ? 'unseen' : '' %>">
      <div class="notify-header" onclick="toggleDetails(this)">
        <div class="header-top">
          <strong><%= p.user?.email || "Guest" %></strong>
          <span>(<%= p.items?.length || 0 %> variant)</span>
        </div>
        <div class="badge-date">
          <button class="badge-mini <%= p.contacted ? 'done' : 'pending' %>"
                  data-id="<%= p._id %>"
                  data-contacted="<%= p.contacted %>"
                  onclick="event.stopPropagation(); toggleContacted(this);">
            <%= p.contacted ? "Đã liên hệ" : "Chưa liên hệ" %>
          </button>
          <small><%= new Date(p.createdAt).toLocaleString("vi-VN") %></small>
        </div>
      </div>

      <% if (p.items && p.items.length > 0) { %>
      <div class="details-wrapper">
        <table class="details-table">
          <thead>
            <tr>
              <th>SKU</th>
              <th>Color</th>
              <th>Size</th>
              <th>Quantity</th>
              <th>Price (VND)</th>
              <th>Total (VND)</th>
              <th>Price (USD)</th>
              <th>Total (USD)</th>
            </tr>
          </thead>
          <tbody>
            <% let totalVND = 0; const exchangeRate = 30000; %>
            <% p.items.forEach(i => { 
                const totalItem = i.price * i.quantity; 
                totalVND += totalItem; 
            %>
              <tr>
                <td><%= i.sku %></td>
                <td><%= i.color?.name || i.color || "-" %></td> <!-- hiển thị color -->
                <td><%= i.size?.name || i.size || "-" %></td>   <!-- hiển thị size -->
                <td><%= i.quantity %></td>
                <td><%= i.price.toLocaleString("vi-VN") %></td>
                <td><%= totalItem.toLocaleString("vi-VN") %></td>
                <td>$<%= (i.price / exchangeRate).toFixed(2) %></td>
                <td>$<%= (totalItem / exchangeRate).toFixed(2) %></td>
              </tr>
            <% }) %>
            <tr class="font-semibold">
              <td colspan="5" style="text-align:right;">Total</td>
              <td><%= totalVND.toLocaleString("vi-VN") %></td>
              <td></td>
              <td>$<%= (totalVND / exchangeRate).toFixed(2) %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  <% }) %>
</div>

<script>
function toggleDetails(headerEl) {
  const item = headerEl.closest('.notify-item');
  const wrapper = item.querySelector('.details-wrapper');
  if (!wrapper) return;
  wrapper.style.display = wrapper.style.display === 'block' ? 'none' : 'block';
}

async function toggleContacted(btn) {
  const id = btn.dataset.id;
  try {
    const res = await fetch(`/api/preorder/${id}/contacted`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
    });
    if (!res.ok) throw new Error("Request failed");
    const data = await res.json();
    btn.textContent = data.contacted ? "Đã liên hệ" : "Chưa liên hệ";
    btn.classList.toggle("done", data.contacted);
    btn.classList.toggle("pending", !data.contacted);
    btn.dataset.contacted = data.contacted;
  } catch (e) {
    console.error(e);
    alert("Không cập nhật được trạng thái");
  }
}

function exportPreorders() {
  window.location.href = '/api/preorder/export';
}
</script>
