<link rel="stylesheet" href="/css/globe.css" />

<style>
/* ====== NOTIFY ITEM ====== */
.notify-item { 
  margin-bottom: 10px; 
  padding: 10px; 
  border-radius: 6px; 
  background: #fff; 
  display: flex; 
  justify-content: flex-start;
  flex-direction: column;
  align-items: flex-start;
}

.notify-item.unseen { border: 1px solid #fca5a5; }

/* ====== HEADER ====== */
.notify-header { 
  display: flex; 
  flex-direction: column; 
  justify-content: space-between; 
  align-items: flex-start; 
  cursor: pointer; 
}

.notify-header .header-top {
  display: flex; 
  flex-wrap: wrap; 
  justify-content: space-between; 
  width: 100%;
  gap: 10px;
}

.notify-header strong {
  font-size: 14px;
}

.notify-header .badge-date {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 5px;
  flex-wrap: wrap;
}

/* ====== DETAILS ====== */
.details-wrapper { 
  display: none; 
  margin-top: 8px; 
  width: 100%;
  overflow-x: auto;
}

.details-table { 
  width: 100%; 
  min-width: 700px; 
  border-collapse: collapse; 
}

.details-table th, .details-table td { 
  border: 1px solid #ddd; 
  padding: 6px 8px; 
  font-size: 13px; 
  text-align: left;
}

.details-table th { 
  background: #ffe6e6; 
  font-weight: 600; 
}

/* ====== BADGE ====== */
.badge-mini { 
  border: none; 
  cursor: pointer; 
  padding: 4px 10px; 
  border-radius: 999px; 
  font-size: 12px; 
  font-weight: 600; 
}

.badge-mini.pending { background: #fde68a; color: #92400e; }
.badge-mini.done { background: #bbf7d0; color: #065f46; }

/* ====== EXPORT BUTTON ====== */
.export-btn { 
  margin-bottom: 15px; 
  padding: 6px 12px; 
  background: black; 
  color: white; 
  cursor: pointer; 
  border-radius: 4px; 
  font-weight: 600; 
}
.export-btn:hover { background: #ffe6e6; color: black; }

/* ====== RESPONSIVE ====== */
@media (max-width: 600px) {
  .notify-header .header-top {
    flex-direction: column;
    align-items: flex-start;
  }
  .details-table { min-width: 100%; }
}
.filter-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
  flex-wrap: wrap;
}

.filter-bar input,
.filter-bar select,
.filter-bar button {
  padding: 6px 10px;
  border: 1px solid #ddd;
}

</style>

<button class="export-btn" onclick="exportPreorders()">Export CSV</button>

<div class="filter-bar">
  <input type="date" id="fromDate" />
  <input type="date" id="toDate" />
  <select id="statusFilter">
    <option value="">Tất cả</option>
    <option value="false">Chưa liên hệ</option>
    <option value="true">Đã liên hệ</option>
  </select>
  <button type="button" class="btn-custom" onclick="applyFilter()">Lọc</button>
</div>

<div class="notify-list">
  <% if (!preorders.length) { %>
    <p class="empty">Không có preorder mới</p>
  <% } %>

  <% preorders.forEach(p => { %>
    <div class="notify-item <%= !p.isSeen ? 'unseen' : '' %>">
      <div class="notify-header" onclick="toggleDetails(this)">
        <div class="header-top">
          <strong><%= p.user?.email || "Guest" %></strong>
          <span>(<%= p.items?.length || 0 %> variant)</span>
        </div>
        <div class="badge-date">
          <button class="badge-mini <%= p.contacted ? 'done' : 'pending' %>"
                  data-id="<%= p._id %>"
                  data-contacted="<%= p.contacted %>"
                  onclick="event.stopPropagation(); toggleContacted(this);">
            <%= p.contacted ? "Đã liên hệ" : "Chưa liên hệ" %>
          </button>
          <small><%= new Date(p.createdAt).toLocaleString("vi-VN") %></small>
        </div>
      </div>

      <% if (p.items && p.items.length > 0) { %>
      <div class="details-wrapper">
        <table class="details-table">
          <thead>
            <tr>
              <th>SKU</th>
              <th>Color</th>
              <th>Size</th>
              <th>Quantity</th>
              <th>Price (VND)</th>
              <th>Total (VND)</th>
              <th>Price (USD)</th>
              <th>Total (USD)</th>
            </tr>
          </thead>
          <tbody>
            <% let totalVND = 0; const exchangeRate = 30000; %>
            <% p.items.forEach(i => { 
                const totalItem = i.price * i.quantity; 
                totalVND += totalItem; 
            %>
              <tr>
                <td><%= i.sku %></td>
                <td><%= i.color?.name || i.color || "-" %></td> <!-- hiển thị color -->
                <td><%= i.size?.name || i.size || "-" %></td>   <!-- hiển thị size -->
                <td><%= i.quantity %></td>
                <td><%= i.price.toLocaleString("vi-VN") %></td>
                <td><%= totalItem.toLocaleString("vi-VN") %></td>
                <td>$<%= (i.price / exchangeRate).toFixed(2) %></td>
                <td>$<%= (totalItem / exchangeRate).toFixed(2) %></td>
              </tr>
            <% }) %>
            <tr class="font-semibold">
              <td colspan="5" style="text-align:right;">Total</td>
              <td><%= totalVND.toLocaleString("vi-VN") %></td>
              <td></td>
              <td>$<%= (totalVND / exchangeRate).toFixed(2) %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  <% }) %>
</div>

<script>
/* ================= APPLY FILTER ================= */
async function applyFilter() {
  const from = document.getElementById("fromDate").value;
  const to = document.getElementById("toDate").value;
  const contacted = document.getElementById("statusFilter").value;

  const params = new URLSearchParams();
  if (from) params.append("from", from);
  if (to) params.append("to", to);
  if (contacted !== "") params.append("contacted", contacted);

  const res = await fetch(`/api/preorder/filter?${params}`, {
    credentials: "include"
  });

  const preorders = await res.json();

  // Render giống layout EJS ban đầu
  const container = document.querySelector(".notify-list");
  if (!preorders.length) {
    container.innerHTML = `<p class="empty">Không có preorder mới</p>`;
    return;
  }

  container.innerHTML = preorders.map(p => `
    <div class="notify-item ${!p.isSeen ? 'unseen' : ''}">
      <div class="notify-header" onclick="toggleDetails(this)">
        <div class="header-top">
          <strong>${p.user?.email || "Guest"}</strong>
          <span>(${p.items?.length || 0} variant)</span>
        </div>
        <div class="badge-date">
          <button class="badge-mini ${p.contacted ? 'done' : 'pending'}"
                  data-id="${p._id}"
                  data-contacted="${p.contacted}"
                  onclick="event.stopPropagation(); toggleContacted(this);">
            ${p.contacted ? "Đã liên hệ" : "Chưa liên hệ"}
          </button>
          <small>${new Date(p.createdAt).toLocaleString("vi-VN")}</small>
        </div>
      </div>

      ${p.items && p.items.length > 0 ? `
      <div class="details-wrapper">
        <table class="details-table">
          <thead>
            <tr>
              <th>SKU</th>
              <th>Color</th>
              <th>Size</th>
              <th>Quantity</th>
              <th>Price (VND)</th>
              <th>Total (VND)</th>
              <th>Price (USD)</th>
              <th>Total (USD)</th>
            </tr>
          </thead>
          <tbody>
            ${p.items.map(i => {
              const total = i.price * i.quantity;
              const exchangeRate = 30000;
              return `
                <tr>
                  <td>${i.sku}</td>
                  <td>${i.color?.name || "-"}</td>
                  <td>${i.size?.name || "-"}</td>
                  <td>${i.quantity}</td>
                  <td>${i.price.toLocaleString("vi-VN")}</td>
                  <td>${total.toLocaleString("vi-VN")}</td>
                  <td>$${(i.price/exchangeRate).toFixed(2)}</td>
                  <td>$${(total/exchangeRate).toFixed(2)}</td>
                </tr>
              `;
            }).join("")}
          </tbody>
        </table>
      </div>
      ` : ""}
    </div>
  `).join("");
}


/* ================= RENDER ================= */
function renderPreorders(preorders) {
  const container = document.querySelector(".notify-list");

  if (!preorders.length) {
    container.innerHTML = `<p>Không có preorder</p>`;
    return;
  }

  container.innerHTML = preorders.map(p => `
    <div style="border:1px solid #ddd; padding:10px; margin-bottom:8px">
      <strong>${p.user?.email || "Guest"}</strong><br/>
      <small>${new Date(p.createdAt).toLocaleString("vi-VN")}</small><br/>
      <span style="color:${p.contacted ? 'green' : 'orange'}">
        ${p.contacted ? "Đã liên hệ" : "Chưa liên hệ"}
      </span>
    </div>
  `).join("");
}

/* ================= EXPORT ================= */
function exportPreorders() {
  const from = document.getElementById("fromDate").value;
  const to = document.getElementById("toDate").value;
  const contacted = document.getElementById("statusFilter").value;

  const params = new URLSearchParams();
  if (from) params.append("from", from);
  if (to) params.append("to", to);
  if (contacted !== "") params.append("contacted", contacted);

  window.location.href = `/api/preorder/export?${params}`;
}
function toggleDetails(headerEl) {
  const item = headerEl.closest('.notify-item');
  const wrapper = item.querySelector('.details-wrapper');
  if (!wrapper) return;
  wrapper.style.display = wrapper.style.display === 'block' ? 'none' : 'block';
}

async function toggleContacted(btn) {
  const id = btn.dataset.id;
  try {
    const res = await fetch(`/api/preorder/${id}/contacted`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
    });
    if (!res.ok) throw new Error("Request failed");
    const data = await res.json();
    btn.textContent = data.contacted ? "Đã liên hệ" : "Chưa liên hệ";
    btn.classList.toggle("done", data.contacted);
    btn.classList.toggle("pending", !data.contacted);
    btn.dataset.contacted = data.contacted;
  } catch (e) {
    console.error(e);
    alert("Không cập nhật được trạng thái");
  }
}

</script>