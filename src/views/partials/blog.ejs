<link rel="stylesheet" href="/css/globe.css">
<!-- Quill CSS + JS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<style>
  /* =========================
   GLOBAL
========================= */

/* =========================
   FORM
========================= */
.form-section {
  background: #fff;
  padding: 20px;
  border-radius: 10px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.ant-form-item {
  display: flex;
  flex-direction: column;
}

.ant-input {
  width: 100%;
}
/* =========================
   LOADING OVERLAY
========================= */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-box {
  background: #fff;
  padding: 16px 24px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  font-size: 14px;
}

/* Spinner */
.spinner {
  width: 22px;
  height: 22px;
  border: 3px solid #eee;
  border-top: 3px solid #ff6b81;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Disable button khi loading */
button.loading {
  opacity: 0.6;
  pointer-events: none;
}
/* =========================
   BUTTON
========================= */
.button-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.btn-custom,
.btn-reset {
  min-width: 120px;
}

/* =========================
   TABLE
========================= */
.promotion-table {
  width: 100%;
  overflow-x: auto;
}

.ant-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 720px; /* cho phép scroll ngang mobile */
}

.ant-table th,
.ant-table td {
  padding: 10px;
  text-align: left;
  vertical-align: top;
}

.blog-preview {
  max-width: 260px;
  white-space: normal;
  word-break: break-word;
}

/* =========================
   MODAL
========================= */
.modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: #fff;
  width: 90%;
  max-width: 700px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 20px;
  border-radius: 12px;
}

/* =========================
   QUILL
========================= */
.ql-container {
  font-size: 14px;
}

.ql-editor img {
  max-width: 100%;
  height: auto;
}

/* =========================
   MOBILE
========================= */
@media (max-width: 768px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .button-row {
    justify-content: stretch;
  }

  .btn-custom,
  .btn-reset {
    width: 100%;
  }

  .ant-table {
    min-width: 600px;
  }

  .blog-preview {
    max-width: 200px;
  }

  .modal-content {
    width: 100%;
    height: 100%;
    border-radius: 0;
    padding: 16px;
  }
}

/* =========================
   SMALL MOBILE
========================= */
@media (max-width: 480px) {
  .section-title {
    font-size: 18px;
  }

  .ant-table {
    min-width: 520px;
  }

  .blog-preview {
    max-width: 160px;
  }
}

</style>
<div class="container">
  <!-- FORM TẠO BLOG (giữ nguyên, không tab) -->
  <div class="form-section">
    <h2 class="section-title">Quản lý Bài viết</h2>

    <form id="blog-form" enctype="multipart/form-data">
      <div class="form-grid">
        <div>
          <div class="ant-form-item" style="grid-column: span 2;">
            <label>Tiêu đề <span class="required">*</span></label>
            <input type="text" name="title" class="ant-input" placeholder="Nhập tiêu đề bài viết" required />
          </div>
          <div class="ant-form-item" style="grid-column: span 2;">
            <label>Ảnh minh họa</label>
            <input type="file" name="blogImages" accept="image/*" multiple class="ant-input" />
            <small style="color:#888">Chọn 1 hoặc nhiều ảnh. Khi thay ảnh sẽ tự xóa ảnh cũ.</small>
          </div>
        </div>
        <div class="ant-form-item" style="grid-column: span 2;">
          <label>Nội dung <span class="required">*</span></label>
          <div id="editor" style="height: 250px; background: white; border: 1px solid #ccc; border-radius: 6px;"></div>
        </div>
      </div>

      <div class="button-row" style="justify-content: flex-end; margin-top: 16px;">
        <button type="reset" class="btn-reset">Đặt lại</button>
        <button type="submit" class="btn-custom">Đăng bài</button>
      </div>
    </form>
  </div>

  <!-- DANH SÁCH -->
  <div class="promotion-table" style="margin-top: 24px;">
    <table class="ant-table">
      <thead>
        <tr>
          <th style="width:60px;">#</th>
          <th>Ảnh</th>
          <th>Tiêu đề (VI/EN)</th>
          <th>Nội dung</th>
          <th>Ngày đăng</th>
          <th style="width:120px;">Hành động</th>
        </tr>
      </thead>
      <tbody id="blogGrid">
        <tr><td colspan="6" style="text-align:center;">Đang tải...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL SỬA -->
<div id="editModal" class="modal" style="display:none;">
  <div class="modal-overlay" onclick="closeEditModal()"></div>
  <div class="modal-content">
    <h2 class="section-title">Chỉnh sửa bài viết</h2>

    <!-- Tabs ngôn ngữ (hiển thị khi bấm Sửa) -->
    <div class="lang-tabs">
      <button type="button" class="lang-btn active" data-lang="vi">🇻🇳 Tiếng Việt</button>
      <button type="button" class="lang-btn" data-lang="en">🇬🇧 English</button>
    </div>

    <form id="editForm" enctype="multipart/form-data">
      <input type="hidden" id="editId" />

      <div class="ant-form-item">
        <label>Tiêu đề</label>
        <input id="editTitle" type="text" class="ant-input" required />
      </div>

      <div class="ant-form-item">
        <label>Ảnh minh họa</label>
        <input id="editImages" type="file" accept="image/*" multiple class="ant-input" />
        <div id="currentImages" style="display:flex;gap:8px;margin-top:8px;"></div>
      </div>

      <div class="ant-form-item">
        <label>Nội dung</label>
        <div id="editEditor" style="height:250px; background:white; border:1px solid #ccc; border-radius:6px;"></div>
      </div>

      <div class="button-row" style="justify-content: flex-end; margin-top:16px;">
        <button type="button" class="btn-reset" onclick="closeEditModal()">Hủy</button>
        <button type="submit" class="btn-custom">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>

<!-- Confirm modal -->
<div id="confirmModal" class="modal" style="display:none; z-index:3000;">
  <div class="modal-overlay"></div>
  <div class="modal-content" style="max-width:400px;">
    <h3 id="confirmTitle">Xác nhận</h3>
    <p id="confirmMessage" style="margin:12px 0 20px;"></p>
    <div class="button-row" style="justify-content:flex-end;">
      <button id="confirmCancel" class="btn-reset">Hủy</button>
      <button id="confirmOk" class="btn-custom">Đồng ý</button>
    </div>
  </div>
</div>
<script>
  
function showLoading(text = "Đang xử lý...") {
  if (document.querySelector(".loading-overlay")) return;

  const overlay = document.createElement("div");
  overlay.className = "loading-overlay";
  overlay.innerHTML = `
    <div class="loading-box">
      <div class="spinner"></div>
      <span>${text}</span>
    </div>
  `;
  document.body.appendChild(overlay);
}

function hideLoading() {
  document.querySelector(".loading-overlay")?.remove();
}

function confirmModal({ 
  title = "Xác nhận",
  message = "Bạn có chắc không?",
  okText = "Đồng ý",
  cancelText = "Hủy"
}) {
  return new Promise(resolve => {
    const modal = document.getElementById("confirmModal");

    document.getElementById("confirmTitle").textContent = title;
    document.getElementById("confirmMessage").textContent = message;

    const okBtn = document.getElementById("confirmOk");
    const cancelBtn = document.getElementById("confirmCancel");

    okBtn.textContent = okText;
    cancelBtn.textContent = cancelText;

    modal.style.display = "flex";

    const cleanUp = (result) => {
      modal.style.display = "none";
      okBtn.onclick = null;
      cancelBtn.onclick = null;
      resolve(result);
    };

    okBtn.onclick = () => cleanUp(true);
    cancelBtn.onclick = () => cleanUp(false);
  });
}

document.addEventListener("DOMContentLoaded", async () => {
  const grid = document.getElementById("blogGrid");
  const form = document.getElementById("blog-form");
  const quill = new Quill("#editor", {
    theme: "snow",
    placeholder: "Nhập nội dung bài viết...",
    modules: {
      toolbar: {
        container: [
          [{ header: [1, 2, 3, false] }],
          ["bold", "italic", "underline", "strike"],
          [{ color: [] }, { background: [] }],
          [{ align: [] }],
          ["link", "image"],
          ["clean"]
        ],
        handlers: {
          image: imageHandler
        }
      }
    }
  });

  let editQuill;
  let currentEditLang = "vi";

  async function loadBlogs() {
    grid.innerHTML = `<tr><td colspan="6" style="text-align:center;">Đang tải...</td></tr>`;

    try {
      const res = await fetch("/api/blogs");
      const blogs = await res.json();

      if (!blogs.length) {
        grid.innerHTML = `<tr><td colspan="6" style="text-align:center;">Chưa có bài viết nào.</td></tr>`;
        return;
      }

      grid.innerHTML = blogs.map((b, i) => {
        // Hiển thị tiêu đề VI | EN nếu có
        const viTitle = b.title?.vi || "(Chưa có VI)";
        const enTitle = b.title?.en ? ` | ${b.title.en}` : "";
        const titleDisplay = viTitle + enTitle;

        // Preview ưu tiên vi, fallback en
        const previewContent = (b.content?.vi || b.content?.en || "").substring(0, 120) + "...";

        const safeTitle = titleDisplay.replace(/'/g, "\\'").replace(/"/g, "&quot;");

        return `
          <tr>
            <td>${i + 1}</td>
            <td>${
              b.images?.[0]
                ? `<img src="${b.images[0]}" alt="${safeTitle}" style="width:70px;height:70px;object-fit:cover;border-radius:4px;">`
                : `<div class="no-img">Không có</div>`
            }</td>
            <td>${titleDisplay}</td>
            <td class="blog-preview">${previewContent}</td>
            <td>${new Date(b.createdAt).toLocaleDateString()}</td>
            <td>
              <button class="btn-edit" onclick="event.stopPropagation(); editBlog('${b._id}')">Sửa</button>
              <button class="btn-delete" onclick="event.stopPropagation(); deleteBlog('${b._id}')">Xóa</button>
            </td>
          </tr>
        `;
      }).join("");

      // Ngăn link trong nội dung click
      grid.querySelectorAll("a").forEach(a => {
        a.addEventListener("click", e => e.preventDefault());
        a.style.pointerEvents = "none";
        a.style.textDecoration = "none";
        a.style.color = "inherit";
      });
    } catch (err) {
      console.error(err);
      grid.innerHTML = `<tr><td colspan="6" style="text-align:center;color:red;">Lỗi tải bài viết.</td></tr>`;
    }
  }

  function imageHandler() {
    // ... Giữ nguyên hàm imageHandler cũ
  }

  async function quillImageHandler(editor) {
    // ... Giữ nguyên hàm quillImageHandler cũ
  }

  window.editBlog = async (id) => {
    console.log("📝 Sửa bài:", id);

    const modal = document.getElementById("editModal");
    const form = document.getElementById("editForm");
    const currentImages = document.getElementById("currentImages");

    document.getElementById("editId").value = id;

    let blog; // Khai báo ngoài để scope toàn hàm
    try {
      const res = await fetch(`/api/blogs/${id}`);
      if (!res.ok) throw new Error("Không thể tải dữ liệu bài viết.");
      blog = await res.json();

      // Ảnh hiện tại
      currentImages.innerHTML = blog.images
        ?.map(img => `<img src="${img}" style="width:80px;height:80px;object-fit:cover;">`)
        .join("") || "";

      // Khởi tạo Quill nếu chưa có
      if (!editQuill) {
        editQuill = new Quill("#editEditor", {
          theme: "snow",
          modules: {
            toolbar: {
              container: [
                [{ header: [1, 2, 3, false] }],
                ["bold", "italic", "underline", "strike"],
                [{ color: [] }, { background: [] }],
                [{ align: [] }],
                ["link", "image"],
                ["clean"]
              ],
              handlers: {
                image: () => quillImageHandler(editQuill)
              }
            }
          }
        });
      }

      // Tab ngôn ngữ - load nội dung cũ theo ngôn ngữ
      document.querySelectorAll("#editModal .lang-btn").forEach(btn => {
        btn.onclick = () => {
          document.querySelectorAll("#editModal .lang-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentEditLang = btn.dataset.lang;

          // Load title & content cũ theo ngôn ngữ (EN có thể null)
          document.getElementById("editTitle").value = blog.title?.[currentEditLang] || "";
          editQuill.root.innerHTML = blog.content?.[currentEditLang] || "";
        };
      });

      // Load mặc định Tiếng Việt
      document.querySelector("#editModal .lang-btn[data-lang='vi']").click();

      modal.style.display = "flex";
    } catch (err) {
      showToast("error", err.message);
      return;
    }

    // Submit form sửa
    form.onsubmit = async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.classList.add("loading");

      showLoading("Đang lưu thay đổi...");

      const titleObj = { [currentEditLang]: document.getElementById("editTitle").value };
      const contentObj = { [currentEditLang]: editQuill.root.innerHTML };

      const formData = new FormData();
      formData.append("title", JSON.stringify(titleObj));
      formData.append("content", JSON.stringify(contentObj));

      const images = document.getElementById("editImages").files;
      for (const img of images) formData.append("blogImages", img);

      try {
        const res = await fetch(`/api/blogs/${id}`, {
          method: "PUT",
          body: formData,
        });
        if (!res.ok) throw new Error("Lỗi cập nhật bài viết");

        showToast("success", "✅ Cập nhật thành công!");
        document.getElementById("editModal").style.display = "none";
        loadBlogs();
      } catch (err) {
        showToast("error", err.message);
      } finally {
        submitBtn.classList.remove("loading");
        hideLoading();
      }
    };
  };

  window.closeEditModal = () => {
    document.getElementById("editModal").style.display = "none";
  };

  form.addEventListener("submit", async e => {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.classList.add("loading");

    showLoading("Đang đăng bài...");

    const formData = new FormData(form);
    formData.set("content", quill.root.innerHTML);

    try {
      const res = await fetch("/api/blogs", {
        method: "POST",
        body: formData
      });
      if (!res.ok) throw new Error("Lỗi đăng bài");

      showToast("success", "✅ Đăng bài thành công!");
      form.reset();
      quill.root.innerHTML = "";
      loadBlogs();
    } catch (err) {
      showToast("error", "❌ " + err.message);
    } finally {
      submitBtn.classList.remove("loading");
      hideLoading();
    }
  });

  window.deleteBlog = async (id) => {
    const ok = await confirmModal({
      title: "Xóa bài viết",
      message: "Hành động này không thể hoàn tác. Bạn chắc chắn muốn xóa?",
      okText: "Xóa",
      cancelText: "Hủy"
    });

    if (!ok) return;

    showLoading("Đang xóa bài viết...");

    try {
      const res = await fetch(`/api/blogs/${id}`, { method: "DELETE" });
      if (!res.ok) throw new Error("Lỗi xóa bài viết");

      showToast("success", "🗑️ Đã xóa bài viết!");
      loadBlogs();
    } catch (err) {
      showToast("error", err.message);
    } finally {
      hideLoading();
    }
  };

  loadBlogs();
});

// Toast thông báo
function showToast(type, message) {
  const container = document.querySelector(".toast-container") || (() => {
    const c = document.createElement("div");
    c.className = "toast-container";
    document.body.appendChild(c);
    return c;
  })();

  const toast = document.createElement("div");
  toast.className = `toast ${type}`;
  toast.textContent = message;
  container.appendChild(toast);

  setTimeout(() => toast.remove(), 3000);
}
</script>
