<!-- src/views/partials/product-import.ejs -->
<form id="fileForm" enctype="multipart/form-data">
  <input type="file" name="csvFile" accept=".csv,.xlsx" required>
  <button type="submit">Upload</button>
</form>

<script>
document.getElementById("fileForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const fileInput = document.querySelector("input[name='csvFile']");
  if (!fileInput.files[0]) {
    alert("Vui lòng chọn file!");
    return;
  }

  const formData = new FormData();
  formData.append("csvFile", fileInput.files[0]);
  console.log("Sending file:", fileInput.files[0].name); // Debug

  try {
    const res = await fetch("/api/products/import", {
      method: "POST",
      body: formData,
    });
    const data = await res.json();
    console.log("Server response:", data); // Debug
    if (!res.ok) throw new Error(data.error || "Lỗi import");
    alert(data.message || "Import thành công!");
  } catch (err) {
    console.error("Import error:", err); // Debug
    alert("Lỗi: " + err.message);
  }
});
</script>